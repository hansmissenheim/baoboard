{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaoBoard",
  "version": "0.2.0",
  "identifier": "io.github.hansmissenheim.baoboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BaoBoard",
        "width": 360,
        "height": 320,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "dragDropEnabled": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; media-src blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/stickers/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNDFGQUUxOUYzQTE2ODYKUldTR0ZqcWY0ZnBCUENkYTA5WHJZbGtEbUFYWG5PeVRMVGR3UXVYVGNZWjAvZXJkYkk1b1lQOXUK",
      "endpoints": [
        "https://github.com/hansmissenheim/baoboard/releases/latest/download/latest.json"
      ]
    }
  }
}
